audiobook-build/
audiobook-build-pron-test/

# The onyx-pron build is the basis of the published audiobook, so its
# provenance is tracked: captions, source chunks, tools, manifest.
# The rendered output and downloaded weights are not — they are large
# and reproducible from the above.
audiobook-build-onyx-pron/videos/
audiobook-build-onyx-pron/books/
audiobook-build-onyx-pron/audio-chunks/
audiobook-build-onyx-pron/models/
audiobook-build-onyx-pron/**/*.log
# raw Whisper dumps; the .srt/.ass/-cues.json derived from them are kept
audiobook-build-onyx-pron/captions/*-words.json

tools/__pycache__/
*.pyc

# generated Hugging Face dataset package (rebuild: tools/build_hf_dataset.py)
hf-dataset/

# epub build scratch
epub-build/work/
epub-build/inspect/
corpus/

# print build scratch
print-build/work/
print-build/tools-calibrate/
# single-book proofs
print-build/*-book01.pdf

# hexameter-retranslation audio: rendered output not tracked — reproducible
# from chunks/ + production settings (see audio-regen-batch.md)
hexameter-retranslation/audio-openai-fable/audio-chunks/
hexameter-retranslation/audio-openai-fable/books/
hexameter-retranslation/audio-openai-fable/backups/
hexameter-retranslation/audio-openai-fable/*.mp3

# hexameter-retranslation revision logs are tracked; the pre-pass snapshot
# copies of the book texts are not (git history now holds every version)
hexameter-retranslation/revision/backup-*/
